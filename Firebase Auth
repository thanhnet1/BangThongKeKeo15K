// Biến lưu trạng thái Admin
let IS_ADMIN = false;

// Lắng nghe đăng nhập từ Firebase
firebase.auth().onAuthStateChanged((user) => {
  if (user) {
    IS_ADMIN = true;
    console.log("Đã đăng nhập quyền Admin");
  } else {
    IS_ADMIN = false;
    console.log("Khách thông thường");
  }
  // Cập nhật lại trạng thái các ô Checkbox trên bảng
  updateCheckboxPermission();
});

// Bật/Tắt thuộc tính disabled của cột Thực tế
function updateCheckboxPermission() {
  const checkboxes = document.querySelectorAll('.thuc-te-checkbox');
  checkboxes.forEach((cb) => {
    if (IS_ADMIN) {
      cb.removeAttribute('disabled'); // Mở khóa cho Admin tích
      cb.style.cursor = 'pointer';
    } else {
      cb.setAttribute('disabled', 'true'); // Khóa đối với người dùng thường
      cb.style.cursor = 'not-allowed';
    }
  });
}
