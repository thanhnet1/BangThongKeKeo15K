<!-- Thêm cụm nút Đăng nhập vào góc trên trang web -->
<div id="admin-auth-container" style="text-align: right; padding: 10px;">
  <button id="btn-login-admin" onclick="openLoginModal()" style="padding: 6px 12px; background: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;">
    🔑 Đăng Nhập Admin
  </button>
  <div id="admin-status" style="display: none; align-items: center; gap: 10px; justify-content: flex-end;">
    <span style="color: green; font-weight: bold;">🟢 Quyền Admin: Bật</span>
    <button id="btn-logout-admin" onclick="logoutAdmin()" style="padding: 6px 12px; background: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer;">
      🚪 Đăng Xuất
    </button>
  </div>
</div>

<!-- Modal Hộp thoại Đăng nhập -->
<div id="login-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 9999; justify-content: center; align-items: center;">
  <div style="background: white; padding: 25px; border-radius: 8px; width: 300px; box-shadow: 0 4px 10px rgba(0,0,0,0.3);">
    <h3 style="margin-top: 0;">Đăng Nhập Admin</h3>
    <input type="email" id="admin-email" placeholder="Email Admin" style="width: 100%; padding: 8px; margin-bottom: 10px; box-sizing: border-box;">
    <input type="password" id="admin-password" placeholder="Mật Khẩu" style="width: 100%; padding: 8px; margin-bottom: 15px; box-sizing: border-box;">
    <div style="display: flex; justify-content: space-between;">
      <button onclick="loginAdmin()" style="padding: 8px 15px; background: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer;">Xác Nhận</button>
      <button onclick="closeLoginModal()" style="padding: 8px 15px; background: #6c757d; color: white; border: none; border-radius: 4px; cursor: pointer;">Hủy</button>
    </div>
  </div>
</div>
// Biến toàn cục lưu trạng thái Admin
let IS_ADMIN_LOGGED_IN = false;

// 1. Mở / Đóng Modal Đăng nhập
function openLoginModal() {
  document.getElementById('login-modal').style.display = 'flex';
}
function closeLoginModal() {
  document.getElementById('login-modal').style.display = 'none';
}

// 2. Thực hiện Đăng Nhập Admin qua Firebase Auth
async function loginAdmin() {
  const email = document.getElementById('admin-email').value;
  const password = document.getElementById('admin-password').value;

  try {
    await firebase.auth().signInWithEmailAndPassword(email, password);
    alert('Đăng nhập Admin thành công!');
    closeLoginModal();
  } catch (error) {
    alert('Đăng nhập thất bại: ' + error.message);
  }
}

// 3. Đăng Xuất Admin
function logoutAdmin() {
  firebase.auth().signOut().then(() => {
    alert('Đã đăng xuất quyền Admin!');
  });
}

// 4. Lắng nghe trạng thái Đăng nhập từ Firebase
firebase.auth().onAuthStateChanged((user) => {
  if (user) {
    // Đã đăng nhập Admin thành công
    IS_ADMIN_LOGGED_IN = true;
    document.getElementById('btn-login-admin').style.display = 'none';
    document.getElementById('admin-status').style.display = 'flex';
  } else {
    // Chưa đăng nhập (Người dùng thông thường)
    IS_ADMIN_LOGGED_IN = false;
    document.getElementById('btn-login-admin').style.display = 'inline-block';
    document.getElementById('admin-status').style.display = 'none';
  }

  // Cập nhật lại thuộc tính ô tích Thực tế trên Bảng
  applyAdminPermissionToCheckboxes();
});

// 5. Hàm áp dụng quyền vào các ô Checkbox thuộc cột "THỰC TẾ"
function applyAdminPermissionToCheckboxes() {
  // Giả sử các ô Checkbox cột Thực tế có class="thuc-te-checkbox"
  const checkboxes = document.querySelectorAll('.thuc-te-checkbox');

  checkboxes.forEach((cb) => {
    if (IS_ADMIN_LOGGED_IN) {
      cb.removeAttribute('disabled');
      cb.style.cursor = 'pointer';
      cb.title = 'Bấm để tích chọn trạng thái thực tế';
    } else {
      cb.setAttribute('disabled', 'true');
      cb.style.cursor = 'not-allowed';
      cb.title = 'Chỉ tài khoản Admin mới có quyền tích chọn!';
    }
  });
}
