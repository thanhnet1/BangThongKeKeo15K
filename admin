<!-- Thêm cụm nút Đăng nhập vào góc trên trang web -->
<div id="admin-auth-container" style="text-align: right; padding: 10px;">
  <button id="btn-login-admin" onclick="openLoginModal()" style="padding: 6px 12px; background: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;">
    🔑 Đăng Nhập Admin
  </button>
  <div id="admin-status" style="display: none; align-items: center; gap: 10px; justify-content: flex-end;">
    <span style="color: green; font-weight: bold;">🟢 Quyền Admin: Bật</span>
    <button id="btn-logout-admin" onclick="logoutAdmin()" style="padding: 6px 12px; background: #dc3545; color: white; border: none; border-radius: 4px; cursor: pointer;">
      🚪 Đăng Xuất
    </button>
  </div>
</div>

<!-- Modal Hộp thoại Đăng nhập -->
<div id="login-modal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 9999; justify-content: center; align-items: center;">
  <div style="background: white; padding: 25px; border-radius: 8px; width: 300px; box-shadow: 0 4px 10px rgba(0,0,0,0.3);">
    <h3 style="margin-top: 0;">Đăng Nhập Admin</h3>
    <input type="email" id="admin-email" placeholder="Email Admin" style="width: 100%; padding: 8px; margin-bottom: 10px; box-sizing: border-box;">
    <input type="password" id="admin-password" placeholder="Mật Khẩu" style="width: 100%; padding: 8px; margin-bottom: 15px; box-sizing: border-box;">
    <div style="display: flex; justify-content: space-between;">
      <button onclick="loginAdmin()" style="padding: 8px 15px; background: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer;">Xác Nhận</button>
      <button onclick="closeLoginModal()" style="padding: 8px 15px; background: #6c757d; color: white; border: none; border-radius: 4px; cursor: pointer;">Hủy</button>
    </div>
  </div>
</div>
