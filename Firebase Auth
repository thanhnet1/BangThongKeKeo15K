// Đặt mật khẩu Admin tùy chọn
const ADMIN_PASSCODE = "123456";
let isAdminVerified = false;

function togglePayment(payKey) {
  // 1. Kiểm tra xác thực Admin
  if (!isAdminVerified) {
    const inputPass = prompt("🔑 Nhập mật khẩu Admin để thay đổi cột THỰC TẾ:");
    
    if (inputPass === ADMIN_PASSCODE) {
      isAdminVerified = true;
      alert("✅ Xác thực Admin thành công!");
    } else if (inputPass !== null) {
      alert("❌ Mật khẩu không đúng! Bạn không có quyền đổi trạng thái cột này.");
      return; // Dừng lại không cho tích
    } else {
      return; // Bấm Hủy (Cancel)
    }
  }

  // 2. Cập nhật trạng thái và lưu lên Firestore
  paymentStatus[payKey] = !paymentStatus[payKey];
  saveDataToFirestore();
}
